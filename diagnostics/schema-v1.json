{
  "schema_version": 1,
  "status": "contract for D1/D2; generated 2026-10-29",
  "limits": {
    "max_request_bytes": 65536,
    "max_events_per_batch": 50,
    "max_event_bytes": 2048,
    "max_batch_bytes": 49152,
    "history_events": 1000,
    "history_bytes": 1048576,
    "upload_queue_events": 200,
    "upload_queue_bytes": 262144,
    "client_session_hex": 32,
    "entry_codes": 4096,
    "detailed_max_ms": 600000,
    "error_dedupe_ms": 10000,
    "context_window_ms": 30000,
    "context_events": 100,
    "auto_promote_max": 20,
    "anomaly_repeat_ms": 30000,
    "send_interval_ms": 5000,
    "upload_timeout_ms": 5000,
    "retry_backoff_ms": [
      5000,
      10000,
      20000,
      40000
    ],
    "max_attempts": 5,
    "max_batch_age_ms": 120000
  },
  "patterns": {
    "client_session": "^[0-9a-f]{32}$",
    "batch_ref": "^[0-9a-f]{32}$",
    "request_ref": "^[0-9a-f]{32}$",
    "load_ref": "^l[0-9]{1,12}$",
    "operation_ref": "^o[0-9]{1,12}$",
    "incident_ref": "^n[0-9]{1,12}$",
    "commit": "^[0-9a-f]{40}$",
    "build_version": "^[A-Za-z0-9._-]{1,96}$"
  },
  "base_fields": [
    "seq",
    "t_ms",
    "level",
    "event",
    "load_ref",
    "operation_ref",
    "request_ref",
    "incident_ref",
    "data"
  ],
  "levels": [
    "debug",
    "info",
    "warn",
    "error"
  ],
  "events": {
    "session.start": {
      "level": "info",
      "fields": {
        "browser_family": {
          "t": "enum",
          "v": [
            "chrome",
            "firefox",
            "safari",
            "edge",
            "other",
            "unknown"
          ]
        },
        "browser_major": {
          "t": "int",
          "min": 0,
          "max": 999,
          "nullable": true
        },
        "viewport_width": {
          "t": "int",
          "min": 0,
          "max": 20000
        },
        "viewport_height": {
          "t": "int",
          "min": 0,
          "max": 20000
        },
        "dpr": {
          "t": "num",
          "min": 0.5,
          "max": 10,
          "nullable": true
        },
        "screen_width": {
          "t": "int",
          "min": 0,
          "max": 20000,
          "nullable": true
        },
        "screen_height": {
          "t": "int",
          "min": 0,
          "max": 20000,
          "nullable": true
        },
        "locale": {
          "t": "str",
          "p": "^[A-Za-z-]{2,20}$",
          "nullable": true
        },
        "touch": {
          "t": "bool"
        },
        "capability_long_tasks": {
          "t": "enum",
          "v": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "capability_memory": {
          "t": "enum",
          "v": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "capability_paint_timing": {
          "t": "enum",
          "v": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "mode": {
          "t": "enum",
          "v": [
            "summary",
            "detailed"
          ]
        },
        "detailed": {
          "t": "bool"
        }
      }
    },
    "session.end": {
      "level": "info",
      "fields": {
        "reason": {
          "t": "enum",
